# ==============================================================================
# Aura Capital — Production Environment Configuration Example (.env.production.example)
# Copy to .env.production on deployment server before launching docker compose
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database & Cache (Docker internal network resolution)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-secure-postgres-password
POSTGRES_DB=aura_capital_prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379

# Web Frontend Port
WEB_PORT=80
CORS_ORIGIN=http://localhost

# Security & Authentication Secrets (MUST be at least 32 characters long in production)
JWT_SECRET=replace-with-production-jwt-signing-secret-minimum-32-chars-long
AUTH_ACCESS_TOKEN_SECRET=replace-with-production-access-token-secret-at-least-32-chars
AUTH_REFRESH_TOKEN_SECRET=replace-with-production-refresh-token-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_ACCESS_TOKEN_ISSUER=aura-capital
AUTH_ACCESS_TOKEN_AUDIENCE=aura-client

# Cookie Security (Set AUTH_REFRESH_COOKIE_SECURE=true when serving over HTTPS/TLS)
AUTH_REFRESH_COOKIE_NAME=aura_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax

# Rate Limiting Policies & HMAC Keys (MUST be at least 32 characters)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_KEY_SECRET=replace-with-production-rate-limit-hmac-key-at-least-32-chars
COMMUNITY_RATE_LIMIT_KEY_SECRET=replace-with-production-community-rl-hmac-key-at-least-32-chars

# Demo User Initialization Password (used by seed:demo on startup)
DEV_SEED_USER_PASSWORD=DemoClientPassword2026!
