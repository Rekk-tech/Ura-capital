# Server Runtime
NODE_ENV=development
PORT=4000
HOST=localhost

# Security & Authentication (FEAT-001 / FEAT-002 / FEAT-004)
# Production secrets must be unique, high-entropy, and supplied via environment/secret manager.
JWT_SECRET=development-fallback-secret-for-jwt-signing-only-minimum-32-chars-long
AUTH_ACCESS_TOKEN_SECRET=aura-capital-dev-access-token-secret-at-least-32-chars
AUTH_REFRESH_TOKEN_SECRET=aura-capital-dev-refresh-token-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_ACCESS_TOKEN_ISSUER=aura-capital
AUTH_ACCESS_TOKEN_AUDIENCE=aura-client
AUTH_REFRESH_COOKIE_NAME=aura_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

# FEAT-010A Rate Limiting (Redis-backed progressive protection)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_KEY_SECRET=aura-capital-dev-rate-limit-hmac-key-at-least-32-chars
AUTH_RATE_LIMIT_TRUST_PROXY=false

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Database & Cache (Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/aura_capital_dev
REDIS_URL=redis://localhost:6379

# FEAT-051 Subscription Provider Foundation
# Mock mode is accepted only for safe local development or isolated test/CI targets.
# Staging, production, production-like, unknown, and conflicting targets fail closed.
SUBSCRIPTION_PROVIDER_MODE=mock
SUBSCRIPTION_PROVIDER_RUN_ID=local
SUBSCRIPTION_PROVIDER_WORKER_ID=worker-0
SUBSCRIPTION_MOCK_WEBHOOK_SECRET=aura-capital-dev-mock-provider-secret-at-least-32-chars

# Phase 8 AI Gateway Foundation (FEAT-058 / P8-D03 Development Configuration)
# Production activation is disabled. Never commit real API keys.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1
GEMINI_MAX_INPUT_TOKENS=4096
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=15000
GEMINI_AUTOMATIC_FALLBACK=false
GEMINI_AUTOMATIC_RETRY=false
GEMINI_API_KEY=
AI_DAILY_QUOTA=50

