// Aura Capital — Identity-Scoped Prisma Schema (Phase 2 Baseline)
// Defines durable storage for identity, credentials, roles, refresh sessions, and audit prerequisites.
// Product domains (academy, simulation, community, subscriptions, AI) are excluded until Phase 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String                    @id @default(uuid())
  email           String                    @unique
  displayName     String?                   @map("display_name")
  status          String                    @default("ACTIVE")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  credentials     Credential[]
  userRoles       UserRole[]
  refreshSessions RefreshSession[]
  auditRecords    AuthSecurityAuditRecord[]

  // Phase 4 Academy relations
  quizAttempts        AcademyQuizAttempt[]
  courseProgress      AcademyUserCourseProgress[]
  lessonProgress      AcademyUserLessonProgress[]
  xp                  AcademyUserXp?
  rewards             AcademyRewardLedger[]

  // Phase 5 Simulation relations
  simulationSessions  SimulationSession[]
  simulationOrders    SimulationOrder[]

  // Phase 6 Community relations
  communityPosts      CommunityPost[]
  communityComments   CommunityComment[]
  communityPostLikes  CommunityPostLike[]

  // Phase 7 Subscription relations
  subscriptions                 UserSubscription[]
  subscriptionTransitionRecords SubscriptionTransitionRecord[]

  @@map("users")
}

model Credential {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  type         String   @default("PASSWORD")
  passwordHash String   @map("password_hash")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id                  String           @id @default(uuid())
  userId              String           @map("user_id")
  tokenHash           String           @unique @map("token_hash")
  familyId            String           @map("family_id")
  replacedBySessionId String?          @unique @map("replaced_by_session_id")
  rotatedAt           DateTime?        @map("rotated_at")
  isRevoked           Boolean          @default(false) @map("is_revoked")
  revokedAt           DateTime?        @map("revoked_at")
  revocationReason    String?          @map("revocation_reason")
  reusedAt            DateTime?        @map("reused_at")
  expiresAt           DateTime         @map("expires_at")
  userAgent           String?          @map("user_agent")
  ipAddress           String?          @map("ip_address")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          RefreshSession?  @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            RefreshSession?  @relation("SessionReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model AuthSecurityAuditRecord {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  eventType     String   @map("event_type")
  outcome       String   @default("SUCCESS")
  actorUserId   String?  @map("actor_user_id")
  subjectUserId String?  @map("subject_user_id")
  requestId     String?  @map("request_id")
  sessionId     String?  @map("session_id")
  identityHash  String?  @map("identity_hash")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([actorUserId])
  @@index([subjectUserId])
  @@index([requestId])
  @@index([occurredAt])
  @@index([createdAt])
  @@map("auth_security_audit_records")
}

// ============================================================================
// Phase 4: Academy Domain Persistence Foundation (FEAT-019)
// ============================================================================

model AcademyCourse {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  level       String   @default("BEGINNER")
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons      AcademyLesson[]
  userProgress AcademyUserCourseProgress[]

  @@map("academy_courses")
}

model AcademyLesson {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  title     String
  slug      String
  content   String?
  order     Int
  status    String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course       AcademyCourse               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  flashcards   AcademyFlashcard[]
  quizzes      AcademyQuiz[]
  userProgress AcademyUserLessonProgress[]

  @@unique([courseId, order])
  @@unique([courseId, slug])
  @@index([courseId])
  @@map("academy_lessons")
}

model AcademyFlashcard {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  front     String
  back      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("academy_flashcards")
}

model AcademyQuiz {
  id           String   @id @default(uuid())
  lessonId     String   @map("lesson_id")
  title        String
  description  String?
  status       String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  order        Int      @default(0)
  passingScore Int      @default(80) @map("passing_score")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson    AcademyLesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questions AcademyQuizQuestion[]
  attempts  AcademyQuizAttempt[]

  @@unique([lessonId, order])
  @@index([lessonId])
  @@map("academy_quizzes")
}

model AcademyQuizQuestion {
  id          String   @id @default(uuid())
  quizId      String   @map("quiz_id")
  prompt      String
  explanation String?
  type        String   @default("SINGLE_CHOICE")
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quiz    AcademyQuiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  options AcademyQuizOption[]
  answers AcademyQuizAnswer[]

  @@unique([quizId, order])
  @@unique([id, quizId])
  @@index([quizId])
  @@map("academy_quiz_questions")
}

model AcademyQuizOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  text       String
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question          AcademyQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedInAnswers AcademyQuizAnswer[]

  @@unique([questionId, order])
  @@unique([id, questionId])
  @@index([questionId])
  @@map("academy_quiz_options")
}

model AcademyQuizAttempt {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  quizId              String    @map("quiz_id")
  attemptNumber       Int       @default(1) @map("attempt_number")
  status              String    @default("CREATED") // CREATED, IN_PROGRESS, SUBMITTED, GRADED
  score               Int?
  passed              Boolean?
  quizTitleSnapshot   String    @map("quiz_title_snapshot")
  quizVersionSnapshot String?   @map("quiz_version_snapshot")
  startedAt           DateTime  @default(now()) @map("started_at")
  submittedAt         DateTime? @map("submitted_at")
  gradedAt            DateTime? @map("graded_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user    User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz    AcademyQuiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers AcademyQuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
  @@unique([id, quizId])
  @@index([userId])
  @@index([quizId])
  @@index([status])
  @@map("academy_quiz_attempts")
}

model AcademyQuizAnswer {
  id                         String   @id @default(uuid())
  attemptId                  String   @map("attempt_id")
  quizId                     String   @map("quiz_id")
  questionId                 String   @map("question_id")
  selectedOptionId           String?  @map("selected_option_id")
  isCorrect                  Boolean? @map("is_correct")
  questionPromptSnapshot     String   @map("question_prompt_snapshot")
  selectedOptionTextSnapshot String?  @map("selected_option_text_snapshot")
  correctOptionIdSnapshot    String?  @map("correct_option_id_snapshot")
  correctOptionTextSnapshot  String?  @map("correct_option_text_snapshot")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  attempt        AcademyQuizAttempt  @relation(fields: [attemptId, quizId], references: [id, quizId], onDelete: Restrict)
  question       AcademyQuizQuestion @relation(fields: [questionId, quizId], references: [id, quizId], onDelete: Restrict)
  selectedOption AcademyQuizOption?  @relation(fields: [selectedOptionId, questionId], references: [id, questionId], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([quizId])
  @@map("academy_quiz_answers")
}

model AcademyUserCourseProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  courseId    String    @map("course_id")
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course AcademyCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("academy_user_course_progress")
}

model AcademyUserLessonProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  status      String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson AcademyLesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("academy_user_lesson_progress")
}

model AcademyUserXp {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  totalXp   Int      @default(0) @map("total_xp")
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("academy_user_xp")
}

model AcademyRewardLedger {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  rewardType     String   @map("reward_type")
  amount         Int
  idempotencyKey String?  @unique @map("idempotency_key")
  status         String   @default("APPLIED") // PENDING, APPLIED, REVERSED
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, sourceType, sourceId, rewardType])
  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("academy_reward_ledger")
}

// ============================================================================
// Phase 5: Simulation Engine Domain Models (FEAT-031)
// ============================================================================

model SimulationScenario {
  id              String                     @id @default(uuid())
  key             String                     @unique
  name            String
  status          String                     @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  marketSnapshots SimulationMarketSnapshot[]
  sessions        SimulationSession[]

  @@map("simulation_scenarios")
}

model SimulationAsset {
  id              String                     @id @default(uuid())
  symbol          String                     @unique
  name            String
  assetType       String                     @default("EQUITY") @map("asset_type") // EQUITY
  status          String                     @default("ACTIVE") // ACTIVE, ARCHIVED
  displayOrder    Int                        @default(0) @map("display_order")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  marketSnapshots SimulationMarketSnapshot[]
  positions       SimulationPosition[]
  orders          SimulationOrder[]
  trades          SimulationTrade[]

  @@map("simulation_assets")
}

model SimulationMarketSnapshot {
  id         String             @id @default(uuid())
  scenarioId String             @map("scenario_id")
  assetId    String             @map("asset_id")
  cycle      Int
  price      Decimal            @db.Decimal(20, 6)
  occurredAt DateTime           @map("occurred_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  scenario   SimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  asset      SimulationAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, cycle, assetId])
  @@index([scenarioId, cycle])
  @@index([assetId])
  @@map("simulation_market_snapshots")
}

model SimulationSession {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  scenarioId   String              @map("scenario_id")
  status       String              @default("CREATED") // CREATED, ACTIVE, COMPLETED, CANCELLED
  startingCash Decimal             @default(100000.0000) @map("starting_cash") @db.Decimal(20, 4)
  currentCycle Int                 @default(1) @map("current_cycle")
  startedAt    DateTime?           @map("started_at")
  completedAt  DateTime?           @map("completed_at")
  cancelledAt  DateTime?           @map("cancelled_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  scenario     SimulationScenario  @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  portfolio    SimulationPortfolio?
  orders       SimulationOrder[]
  trades       SimulationTrade[]

  @@unique([id, userId])
  @@index([userId])
  @@index([scenarioId])
  @@index([status])
  @@map("simulation_sessions")
}

model SimulationPortfolio {
  id          String               @id @default(uuid())
  sessionId   String               @unique @map("session_id")
  cashBalance Decimal              @map("cash_balance") @db.Decimal(20, 4)
  realizedPnl Decimal              @default(0.0000) @map("realized_pnl") @db.Decimal(20, 4)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  session     SimulationSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  positions   SimulationPosition[]

  @@map("simulation_portfolios")
}

model SimulationPosition {
  id          String              @id @default(uuid())
  portfolioId String              @map("portfolio_id")
  assetId     String              @map("asset_id")
  quantity    Int
  averageCost Decimal             @map("average_cost") @db.Decimal(20, 6)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  portfolio   SimulationPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  asset       SimulationAsset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
  @@index([assetId])
  @@map("simulation_positions")
}

model SimulationOrder {
  id                 String            @id @default(uuid())
  sessionId          String            @map("session_id")
  userId             String            @map("user_id")
  assetId            String            @map("asset_id")
  side               String            // BUY, SELL
  type               String            @default("MARKET") // MARKET
  quantity           Int
  status             String            @default("RECEIVED") // RECEIVED, FILLED, REJECTED
  idempotencyKey     String            @map("idempotency_key")
  requestFingerprint String            @map("request_fingerprint")
  rejectionCode      String?           @map("rejection_code")
  executionPrice     Decimal?          @map("execution_price") @db.Decimal(20, 6)
  executedQuantity   Int?              @map("executed_quantity")
  submittedAt        DateTime          @default(now()) @map("submitted_at")
  filledAt           DateTime?         @map("filled_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  session            SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  asset              SimulationAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  trade              SimulationTrade?

  @@unique([userId, sessionId, idempotencyKey])
  @@unique([id, sessionId, assetId])
  @@index([sessionId])
  @@index([userId])
  @@index([assetId])
  @@index([status])
  @@map("simulation_orders")
}

model SimulationTrade {
  id             String            @id @default(uuid())
  orderId        String            @unique @map("order_id")
  sessionId      String            @map("session_id")
  assetId        String            @map("asset_id")
  side           String            // BUY, SELL
  quantity       Int
  executionPrice Decimal           @map("execution_price") @db.Decimal(20, 6)
  notional       Decimal           @map("notional") @db.Decimal(20, 4)
  realizedPnl    Decimal           @default(0.0000) @map("realized_pnl") @db.Decimal(20, 4)
  executedAt     DateTime          @default(now()) @map("executed_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  order          SimulationOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  session        SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  asset          SimulationAsset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([assetId])
  @@index([orderId])
  @@map("simulation_trades")
}

// ============================================================================
// Phase 6 — Community Models
// ============================================================================

model CommunityPost {
  id        String              @id @default(uuid())
  authorId  String              @map("author_id")
  content   String              @db.Text
  status    String              @default("VISIBLE") // VISIBLE, HIDDEN, REMOVED
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  removedAt DateTime?           @map("removed_at")

  author    User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  comments  CommunityComment[]
  likes     CommunityPostLike[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "community_posts_status_created_at_id_idx")
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], map: "community_posts_author_id_created_at_id_idx")
  @@map("community_posts")
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  authorId  String        @map("author_id")
  content   String        @db.Text
  status    String        @default("VISIBLE") // VISIBLE, HIDDEN, REMOVED
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  removedAt DateTime?     @map("removed_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt(sort: Asc), id(sort: Asc)], map: "community_comments_post_id_created_at_id_idx")
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], map: "community_comments_author_id_created_at_id_idx")
  @@map("community_comments")
}

model CommunityPostLike {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], map: "community_post_likes_user_id_post_id_key")
  @@index([postId, createdAt(sort: Desc)], map: "community_post_likes_post_id_created_at_idx")
  @@index([userId, createdAt(sort: Desc)], map: "community_post_likes_user_id_created_at_idx")
  @@map("community_post_likes")
}

// ============================================================================
// Phase 7 — Subscription Models
// ============================================================================

model UserSubscription {
  id                     String                        @id @default(uuid())
  userId                 String                        @map("user_id")
  planKey                String                        @default("FREE") @map("plan_key")
  status                 String                        @default("ACTIVE")
  providerKey            String                        @default("INTERNAL") @map("provider_key")
  externalSubscriptionId String?                       @map("external_subscription_id")
  currentPeriodStart     DateTime                      @map("current_period_start")
  currentPeriodEnd       DateTime                      @map("current_period_end")
  cancelAtPeriodEnd      Boolean                       @default(false) @map("cancel_at_period_end")
  providerSequence       String?                       @map("provider_sequence")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  user                   User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerEvents         SubscriptionProviderEvent[]
  transitionRecords      SubscriptionTransitionRecord[]

  @@index([userId], map: "user_subscriptions_user_id_idx")
  @@index([status], map: "user_subscriptions_status_idx")
  @@index([providerKey], map: "user_subscriptions_provider_key_idx")
  @@index([currentPeriodEnd], map: "user_subscriptions_period_end_idx")
  @@map("user_subscriptions")
}

model SubscriptionProviderEvent {
  id              String            @id @default(uuid())
  providerKey     String            @map("provider_key")
  providerEventId String            @map("provider_event_id")
  eventType       String            @map("event_type")
  outcome         String            @default("RECEIVED")
  occurredAt      DateTime          @map("occurred_at")
  receivedAt      DateTime          @default(now()) @map("received_at")
  processedAt     DateTime?         @map("processed_at")
  payloadDigest   String?           @map("payload_digest")
  metadata        Json?             @map("metadata")
  subscriptionId  String?           @map("subscription_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  subscription    UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([providerKey, providerEventId], map: "subscription_provider_events_provider_event_uidx")
  @@index([subscriptionId], map: "subscription_provider_events_subscription_id_idx")
  @@index([occurredAt(sort: Desc)], map: "subscription_provider_events_occurred_at_idx")
  @@index([receivedAt(sort: Desc)], map: "subscription_provider_events_received_at_idx")
  @@index([outcome], map: "subscription_provider_events_outcome_idx")
  @@map("subscription_provider_events")
}

model SubscriptionTransitionRecord {
  id                  String           @id @default(uuid())
  subscriptionId      String           @map("subscription_id")
  userId              String           @map("user_id")
  fromStatus          String?          @map("from_status")
  toStatus            String           @map("to_status")
  fromPlan            String?          @map("from_plan")
  toPlan              String           @map("to_plan")
  source              String           @map("source")
  transactionStrategy String           @map("transaction_strategy")
  reason              String?          @map("reason")
  providerEventId     String?          @map("provider_event_id")
  actorId             String?          @map("actor_id")
  subjectId           String?          @map("subject_id")
  requestId           String?          @map("request_id")
  correlationId       String?          @map("correlation_id")
  metadata            Json?            @map("metadata")
  createdAt           DateTime         @default(now()) @map("created_at")

  subscription        UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt(sort: Asc)], map: "subscription_transition_records_subscription_created_idx")
  @@index([userId, createdAt(sort: Asc)], map: "subscription_transition_records_user_created_idx")
  @@index([correlationId], map: "subscription_transition_records_correlation_idx")
  @@index([providerEventId], map: "subscription_transition_records_provider_event_idx")
  @@map("subscription_transition_records")
}


