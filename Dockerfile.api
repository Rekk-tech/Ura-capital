# ==========================================
# Dockerfile.api - Aura Capital API Server
# Production Multi-Stage Container
# ==========================================

FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies for native modules (Argon2, etc.)
RUN apk add --no-cache python3 make g++

# Copy root monorepo manifests
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/

# Install all workspace dependencies
RUN npm install

# Copy source trees
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Build Shared Package
RUN npm run build:shared

# Generate Prisma Client & Build API
WORKDIR /app/apps/api
RUN npx prisma generate
RUN npm run build

# ==========================================
# Runner Stage
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Install production essentials
RUN apk add --no-cache openssl

# Copy node_modules and built packages
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json

WORKDIR /app/apps/api

EXPOSE 3000

# On container start: apply migrations then launch express API
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]

